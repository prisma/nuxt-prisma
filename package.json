{
  "name": "@prisma/nuxt",
  "version": "0.0.35",
  "description": "Prisma ORM integration for Nuxt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prisma/nuxt-prisma.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run prepack && changelogen --release && npm publish --access public && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean:playground": "rm -rf ./playground/prisma ./playground/node_modules ./playground/prisma.config.ts ./playground/.env ./playground/generated ./playground/server ./playground/.nuxt",
    "prepare": "husky install",
    "commit": "npx git-cz",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "^3.0.0",
    "@nuxt/kit": "^4.2.0",
    "consola": "^3.4.2",
    "tinyexec": "^1.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@commitlint/cz-commitlint": "^19.5.0",
    "@nuxt/devtools": "^3.0.0",
    "@nuxt/eslint-config": "^1.10.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.2.0",
    "@nuxt/test-utils": "^3.20.1",
    "@types/node": "^20.11.17",
    "changelogen": "^0.5.5",
    "commitizen": "^4.3.1",
    "cz-customizable": "^7.2.1",
    "eslint": "^9.0.0",
    "husky": "^8.0.0",
    "nuxt": "^4.2.0",
    "prettier": "3.2.5",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "prisma": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/adapter-ppg": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/adapter-pg": {
      "optional": true
    },
    "@prisma/adapter-ppg": {
      "optional": true
    }
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./.cz-config.cjs"
    }
  }
}
